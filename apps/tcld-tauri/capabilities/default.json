{
  "$schema": "https://schema.tauri.app/config/2/capabilities",
  "identifier": "default",
  "description": "Default permissions for TCL Decompiler",
  "windows": [
    "main",
    "preferences",
    "run-configuration",
    "launch-profiles"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save"
  ],
  "platforms": [
    "macOS",
    "windows",
    "linux"
  ]
}
